# Copy to .env and fill in. NEVER commit .env or put the secret in assets/js/env.js
PORT=8080
BASE_URL=https://www.diabloserversmp.qzz.io
GOOGLE_CLIENT_ID=PASTE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PASTE_CLIENT_SECRET
# comma separated, bare domains only. Empty = any Google account
GOOGLE_ALLOWED_DOMAINS=
# any long random string
SESSION_SECRET=change-me-to-a-long-random-string
